{
  "name": "pi-courier",
  "version": "0.1.27",
  "description": "Run pi coding agent from Matrix. Slash commands, skills and prompts fully work from messengers via the RPC protocol.",
  "type": "module",
  "main": "dist/standalone.js",
  "bin": {
    "pi-courier": "dist/cli.js"
  },
  "files": [
    "dist/",
    "deploy/",
    "extensions/",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/standalone.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "messenger",
    "bridge",
    "matrix",
    "telegram",
    "rpc",
    "remote",
    "chat",
    "bot"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hi-Barry/pi-courier.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "matrix-bot-sdk": "^0.8.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83",
    "@earendil-works/pi-coding-agent": ">=0.83"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.2",
    "fast-check": "^4.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
