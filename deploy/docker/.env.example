# pi-courier 一键部署配置示例
# 复制为 .env 并填入真实值: cp .env.example .env
# 注意:.env 包含敏感信息(token/key),已被 gitignore,不要提交!

# ---- Matrix(必须)----
PI_MATRIX_HOMESERVER=https://matrix.purplelin.com
PI_MATRIX_ACCESS_TOKEN=syt_你的token

# ---- 信任用户(可选,逗号分隔;不设则走验证码配对)----
PI_MATRIX_TRUSTED_USERS=@barry:matrix.purplelin.com

# ---- 加密(可选,默认 true)----
PI_MATRIX_ENCRYPTION=true

# ---- 工作目录(可选,容器内路径)----
PI_WORKDIR=/root/Projects

# ---- LLM(必须)----
PI_LLM_API_KEY=sk-你的key

# ---- 默认 provider/模型(可选)----
PI_DEFAULT_PROVIDER=opencode-go
PI_DEFAULT_MODEL=deepseek-v4-flash

# ---- 日志级别(可选:debug/info/warn/error)----
# PI_LOG_LEVEL=info

# ---- GitHub CLI(可选)----
# GH_TOKEN=ghp_xxx
